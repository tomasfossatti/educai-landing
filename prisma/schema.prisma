generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role { STUDENT TEACHER }
enum MaterialType { TEXT PDF MARKDOWN }
enum MaterialState { DRAFT ACTIVE RETIRED }
enum ConversationStatus { ACTIVE ARCHIVED DELETED }
enum MessageRole { STUDENT ASSISTANT SYSTEM }
enum EvidenceState { NO_DATA INSUFFICIENT SUFFICIENT }
enum SignalType { QUESTION CONFUSION REFORMULATION }
enum ExplanationType { CONCRETE_EXAMPLE ANALOGY STEP_BY_STEP DEFINITION COMPARISON APPLIED_CASE OTHER }
enum UnderstandingSignal { EXPLICIT_CONFIRMATION ADVANCED_WITHOUT_REPETITION REDUCED_CONFUSION FEEDBACK_POSITIVE NONE }
enum RecommendationStatus { GENERATED VIEWED APPLIED DISCARDED }
enum SessionStatus { OPEN CLOSED }

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  role         Role
  passwordHash String
  passwordSalt String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  teacher      TeacherProfile?
  student      StudentProfile?
  sessions     AuthSession[]
}

model AuthSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
}

model TeacherProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  courses Course[]
}

model StudentProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrollments Enrollment[]
  conversations Conversation[]
  feedback StudentFeedback[]
}

model Course {
  id           String   @id @default(cuid())
  teacherId    String
  name         String
  description  String
  joinCode     String   @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  teacher      TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  enrollments  Enrollment[]
  activities   Activity[]
  materials    LearningMaterial[]
  conversations Conversation[]
  concepts     Concept[]
  insights     AggregatedInsight[]
  recommendations Recommendation[]
  interventions TeacherIntervention[]
  sessions     ClassSession[]
  feedback     StudentFeedback[]
  feedbackAggregates FeedbackAggregate[]
  contentChunks ContentChunk[]
  @@index([teacherId])
}

model Enrollment {
  id        String   @id @default(cuid())
  courseId  String
  studentId String
  joinedAt  DateTime @default(now())
  course    Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  @@unique([courseId, studentId])
  @@index([studentId])
}

model Activity {
  id          String   @id @default(cuid())
  courseId    String
  title       String
  description String
  createdAt   DateTime @default(now())
  course      Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  sessions ClassSession[]
  @@index([courseId])
}

model LearningMaterial {
  id        String        @id @default(cuid())
  courseId  String
  title     String
  type      MaterialType
  state     MaterialState @default(DRAFT)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  course    Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  versions  LearningMaterialVersion[]
  chunks    ContentChunk[]
  @@index([courseId, state])
}

model LearningMaterialVersion {
  id         String   @id @default(cuid())
  materialId String
  version    Int
  rawText    String   @db.Text
  fileName   String?
  fileMime   String?
  fileData   Bytes?
  createdAt  DateTime @default(now())
  material   LearningMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  chunks     ContentChunk[]
  @@unique([materialId, version])
}

model ContentChunk {
  id         String @id @default(cuid())
  courseId   String
  materialId String
  versionId  String
  position   Int
  text       String @db.Text
  searchText String @db.Text
  material   LearningMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  version    LearningMaterialVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  course     Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  @@unique([versionId, position])
  @@index([courseId])
  @@index([materialId])
}

model Conversation {
  id         String   @id @default(cuid())
  courseId   String
  activityId String?
  studentId  String
  status     ConversationStatus @default(ACTIVE)
  consentedAt DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  course     Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  activity   Activity? @relation(fields: [activityId], references: [id], onDelete: SetNull)
  student    StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  messages   Message[]
  analyses   ConversationAnalysis[]
  @@index([courseId, activityId])
  @@index([studentId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  role           MessageRole
  content        String   @db.Text
  sourceChunkIds Json?
  createdAt      DateTime @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  @@index([conversationId, createdAt])
}

model Concept {
  id        String   @id @default(cuid())
  courseId  String
  name      String
  slug      String
  createdAt DateTime @default(now())
  course    Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  signals   ConceptSignal[]
  insights  AggregatedInsight[]
  feedback  StudentFeedback[]
  feedbackAggregates FeedbackAggregate[]
  @@unique([courseId, slug])
}

model ConversationAnalysis {
  id             String   @id @default(cuid())
  conversationId String
  participantKey String
  schemaVersion  String   @default("v1")
  modelProvider  String
  modelName      String
  createdAt      DateTime @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  signals        ConceptSignal[]
  @@index([conversationId, createdAt])
  @@index([participantKey])
}

model ConceptSignal {
  id                    String   @id @default(cuid())
  analysisId            String
  conceptId             String
  participantKey        String
  type                   SignalType
  evidenceSnippet       String   @db.Text
  explanationType       ExplanationType?
  understandingSignal   UnderstandingSignal @default(NONE)
  createdAt              DateTime @default(now())
  analysis               ConversationAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  concept                Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  @@index([conceptId, participantKey])
  @@index([analysisId])
}

model AggregatedInsight {
  id                   String   @id @default(cuid())
  courseId             String
  conceptId            String
  affectedParticipants Int
  totalParticipants    Int
  proportion           Float
  evidenceState        EvidenceState
  summary              String   @db.Text
  evidenceJson         Json
  explanationJson      Json
  generatedAt          DateTime @default(now())
  course               Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  concept              Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  recommendations      Recommendation[]
  interventions        TeacherIntervention[]
  @@unique([courseId, conceptId])
  @@index([courseId, evidenceState])
}

model Recommendation {
  id         String   @id @default(cuid())
  courseId   String
  insightId  String
  title      String
  rationale  String   @db.Text
  actionText String   @db.Text
  status     RecommendationStatus @default(GENERATED)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  course     Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  insight    AggregatedInsight @relation(fields: [insightId], references: [id], onDelete: Cascade)
  interventions TeacherIntervention[]
  @@index([courseId, status])
}

model TeacherIntervention {
  id               String   @id @default(cuid())
  courseId         String
  insightId        String?
  recommendationId String?
  sessionId        String?
  actualAction     String?  @db.Text
  createdAt        DateTime @default(now())
  course           Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  insight          AggregatedInsight? @relation(fields: [insightId], references: [id], onDelete: SetNull)
  recommendation   Recommendation? @relation(fields: [recommendationId], references: [id], onDelete: SetNull)
  session          ClassSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  @@index([courseId])
}

model ClassSession {
  id          String   @id @default(cuid())
  courseId    String
  activityId  String?
  title       String
  status      SessionStatus @default(OPEN)
  startedAt   DateTime @default(now())
  endedAt     DateTime?
  course      Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  activity    Activity? @relation(fields: [activityId], references: [id], onDelete: SetNull)
  interventions TeacherIntervention[]
  feedback     StudentFeedback[]
  aggregates   FeedbackAggregate[]
  @@index([courseId, status])
}

model StudentFeedback {
  id         String   @id @default(cuid())
  courseId   String
  sessionId  String
  studentId  String
  conceptId  String
  clarity    Int
  stillDoubt Boolean
  comment    String?  @db.Text
  createdAt  DateTime @default(now())
  course     Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  session    ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student    StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  concept    Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  @@unique([sessionId, studentId, conceptId])
  @@index([courseId, sessionId])
}

model FeedbackAggregate {
  id               String   @id @default(cuid())
  courseId         String
  sessionId        String
  conceptId        String
  responseCount    Int
  averageClarity   Float
  stillDoubtCount  Int
  stillDoubtRate   Float
  generatedAt      DateTime @default(now())
  course           Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  session          ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  concept          Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  @@unique([sessionId, conceptId])
  @@index([courseId])
}
